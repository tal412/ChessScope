    "allow": [
      "Bash(git add:*)",
      "Bash(grep:*)",
      "Bash(mv:*)",
      "Bash(npx eslint:*)",
      "Bash(npm install:*)",
      "Bash(node:*)",
      "Bash(sed:*)",
      "Bash(npm run dev:*)",
