# Google Drive API Configuration
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env in the root directory
# 2. Follow the instructions in GOOGLE_DRIVE_SETUP.md to get your credentials
# 3. Replace the placeholder values with your actual credentials
# 4. The .env file is gitignored to keep your credentials safe

# Google API Key
# Get this from: Google Cloud Console > APIs & Services > Credentials > API Keys
VITE_GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# Google OAuth 2.0 Client ID
# Get this from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com